@model DepartmentFormViewModel
@{
    ViewData["Title"] = "Edit Department";
}

<section class="admin-page-heading compact">
    <div>
        <a class="admin-back-link" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i>Department details</a>
        <h1>Edit @Model.Code</h1>
        <p>Update this department while preserving its stable database identity.</p>
    </div>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form-panel">
    <input asp-for="Id" type="hidden" />
    <header><span><i class="bi bi-pencil-square"></i></span><div><h2>Department information</h2><p>Changes will be available to future connected academic modules.</p></div></header>
    <div class="admin-form-body"><partial name="_DepartmentForm" model="Model" /></div>
    <footer><a class="admin-secondary-button" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="admin-primary-button" type="submit"><i class="bi bi-check-lg"></i>Save changes</button></footer>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
