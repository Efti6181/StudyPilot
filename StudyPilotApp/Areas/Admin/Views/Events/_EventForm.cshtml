@model AdminEventFormViewModel

<div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>
<div class="admin-form-grid">
    <div class="admin-field admin-field-full"><label asp-for="Title"></label><input asp-for="Title" maxlength="180" placeholder="Example: Future Tech & AI Workshop" /><span asp-validation-for="Title"></span></div>
    <div class="admin-field admin-field-full"><label asp-for="ShortDescription"></label><textarea asp-for="ShortDescription" rows="2" maxlength="320" placeholder="A clear summary shown on the student event card."></textarea><div class="admin-field-meta"><span asp-validation-for="ShortDescription"></span><small>Maximum 320 characters</small></div></div>
    <div class="admin-field"><label asp-for="Type"></label><select asp-for="Type"><option value="">Select event type</option>@foreach (var type in Enum.GetValues<CampusEventType>()){<option value="@((int)type)">@type</option>}</select><span asp-validation-for="Type"></span></div>
    <div class="admin-field"><label asp-for="LocationType"></label><select asp-for="LocationType" id="eventLocationType"><option value="">Select event format</option>@foreach (var location in Enum.GetValues<EventLocationType>()){<option value="@((int)location)">@(location == EventLocationType.OnCampus ? "On Campus" : location.ToString())</option>}</select><span asp-validation-for="LocationType"></span></div>
    <div class="admin-field" id="eventVenueField"><label asp-for="Venue"></label><input asp-for="Venue" maxlength="250" placeholder="Auditorium, lab or campus room" /><span asp-validation-for="Venue"></span></div>
    <div class="admin-field" id="eventOnlineUrlField"><label asp-for="OnlineUrl"></label><input asp-for="OnlineUrl" type="url" maxlength="2048" placeholder="https://meet.example.com/event" /><span asp-validation-for="OnlineUrl"></span></div>
    <div class="admin-field admin-field-full"><label asp-for="OrganizerName"></label><input asp-for="OrganizerName" maxlength="150" placeholder="Department, club or university office" /><span asp-validation-for="OrganizerName"></span></div>
    <div class="admin-field"><label asp-for="StartAt"></label><input asp-for="StartAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="StartAt"></span><small>Bangladesh Standard Time (UTC+6)</small></div>
    <div class="admin-field"><label asp-for="EndAt"></label><input asp-for="EndAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="EndAt"></span><small>Must be after the start time</small></div>
    <div class="admin-field"><label asp-for="RegistrationDeadline"></label><input asp-for="RegistrationDeadline" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="RegistrationDeadline"></span><small>Must not be after the event starts</small></div>
    <div class="admin-field"><label asp-for="Capacity"></label><input asp-for="Capacity" type="number" min="1" max="100000" placeholder="Leave empty for unlimited" /><span asp-validation-for="Capacity"></span></div>
    <div class="admin-field admin-field-full"><label asp-for="Description"></label><textarea asp-for="Description" rows="7" maxlength="5000" placeholder="Full event information, requirements, schedule and instructions."></textarea><div class="admin-field-meta"><span asp-validation-for="Description"></span><small>Maximum 5,000 characters</small></div></div>
    <div class="admin-field admin-field-full"><label class="admin-switch-row"><input asp-for="IsPublished" /><span class="admin-switch-control"></span><span><strong>Publish for students</strong><small>Published events appear immediately in the existing Student Events module. Leave disabled to save a draft.</small></span></label></div>
</div>
