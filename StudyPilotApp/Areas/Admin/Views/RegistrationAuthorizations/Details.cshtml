@model RegistrationAuthorizationDetailsViewModel
@{ ViewData["Title"] = Model.FullName; }
<section class="admin-page-heading"><div><a class="admin-back-link" asp-action="Index"><i class="bi bi-arrow-left"></i>Registration Authorization</a><h1>@Model.FullName</h1><p>Review verified identity, academic placement, and registration state.</p></div><div class="admin-heading-actions"><a class="admin-secondary-button" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i>Edit</a><form asp-action="SetStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="isActive" value="@(!Model.IsActive)" /><button class="@(Model.IsActive ? "admin-danger-button" : "admin-primary-button")" type="submit"><i class="bi @(Model.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>@(Model.IsActive ? "Deactivate" : "Activate")</button></form></div></section>
<div class="admin-details-grid"><section class="admin-panel admin-auth-details"><div class="admin-auth-identity"><span class="@Model.Role.ToLowerInvariant()"><i class="bi @(Model.Role == "Student" ? "bi-mortarboard" : "bi-person-badge")"></i></span><div><span class="admin-role-chip @Model.Role.ToLowerInvariant()">@Model.Role</span><h2>@Model.FullName</h2><p>@Model.Email</p><strong>@Model.UniversityId</strong></div></div><div class="admin-program-facts"><span><small>Registration</small><strong>@(Model.IsClaimed ? "Registered" : "Not registered")</strong></span><span><small>Authorization</small><strong>@(Model.IsActive ? "Enabled" : "Disabled")</strong></span></div><dl class="admin-auth-academic"><div><dt>Department</dt><dd>@(Model.DepartmentCode is null ? "Legacy record — not assigned" : $"{Model.DepartmentCode} — {Model.DepartmentName}")</dd></div>@if(Model.Role == "Student"){<div><dt>Program</dt><dd>@(Model.ProgramCode is null ? "Not assigned" : $"{Model.ProgramCode} — {Model.ProgramName}")</dd></div><div><dt>Batch / Semester</dt><dd>@(Model.Batch ?? "—") / @(Model.CurrentSemester?.ToString() ?? "—")</dd></div>}</dl></section><aside class="admin-panel admin-record-meta"><h2>Record information</h2><dl><div><dt>Authorization ID</dt><dd>#@Model.Id</dd></div><div><dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</dd></div><div><dt>Registered</dt><dd>@(Model.RegisteredAt?.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") ?? "Not registered yet")</dd></div><div><dt>Identity account</dt><dd>@(Model.ApplicationUserId is null ? "Not linked" : "Linked securely")</dd></div></dl></aside></div>
@if(Model.IsClaimed){<section class="admin-info-callout"><i class="bi bi-info-circle"></i><div><strong>This record has been claimed</strong><p>Deactivating this registry record does not disable the existing Identity account. Account suspension will be handled by the upcoming User Management module.</p></div></section>}
