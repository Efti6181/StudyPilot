@model CourseCatalogDetailsViewModel
@{ ViewData["Title"] = Model.Code; }
<section class="admin-page-heading"><div><a class="admin-back-link" asp-action="Index"><i class="bi bi-arrow-left"></i>Course catalog</a><h1>@Model.Code — @Model.Name</h1><p>Review the official academic and Smart Study Plan metadata.</p></div><div class="admin-heading-actions"><a class="admin-secondary-button" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i>Edit</a><form asp-action="SetStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="isActive" value="@(!Model.IsActive)" /><button class="@(Model.IsActive ? "admin-danger-button" : "admin-primary-button")" type="submit"><i class="bi @(Model.IsActive ? "bi-archive" : "bi-arrow-counterclockwise")"></i>@(Model.IsActive ? "Archive" : "Activate")</button></form></div></section>
<div class="admin-details-grid">
    <section class="admin-panel admin-catalog-hero"><span class="admin-catalog-code">@Model.Code</span><div><span class="admin-status-pill @(Model.IsActive ? "active" : "inactive")"><i></i>@(Model.IsActive ? "Active" : "Inactive")</span><h2>@Model.Name</h2><a class="admin-detail-department" asp-controller="Departments" asp-action="Details" asp-route-id="@Model.DepartmentId"><i class="bi bi-building"></i>@Model.DepartmentCode — @Model.DepartmentName</a>@if(Model.ProgramId.HasValue){<a class="admin-detail-department" asp-controller="Programs" asp-action="Details" asp-route-id="@Model.ProgramId"><i class="bi bi-diagram-3"></i>@Model.ProgramCode — @Model.ProgramName</a>}else{<span class="admin-catalog-all-programs"><i class="bi bi-diagram-2"></i>Available to all department programs</span>}<p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No official course description has been provided." : Model.Description)</p><div class="admin-catalog-facts"><span><small>Credits</small><strong>@Model.CreditHours.ToString("0.#")</strong></span><span><small>Type</small><strong>@Model.CourseType</strong></span><span><small>Semester</small><strong>@(Model.RecommendedSemester?.ToString() ?? "Flexible")</strong></span><span><small>Difficulty</small><strong>@Model.Difficulty</strong></span><span><small>Career</small><strong>@Model.CareerRelevance</strong></span></div></div></section>
    <aside class="admin-panel admin-record-meta"><h2>Record information</h2><dl><div><dt>Catalog ID</dt><dd>#@Model.Id</dd></div><div><dt>Prerequisites</dt><dd>@(Model.Prerequisites ?? "None specified")</dd></div><div><dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</dd></div><div><dt>Last updated</dt><dd>@(Model.UpdatedAt?.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") ?? "Not updated yet")</dd></div></dl></aside>
</div>
<div class="admin-info-callout"><i class="bi bi-stars"></i><div><strong>Smart planning metadata</strong><p>Difficulty and career relevance provide the canonical information needed for AI-assisted workload and career-priority recommendations.</p></div></div>
<section class="admin-panel admin-faculty-assignments">
    <header><div><h2><i class="bi bi-person-workspace"></i> Faculty assignments</h2><p>Select any registered Faculty account. The same course can be assigned to multiple Faculty members, terms, or sections.</p></div></header>
    <form asp-action="AssignFaculty" asp-route-id="@Model.Id" method="post" class="admin-faculty-assignment-form">
        <label><span>Faculty</span><select name="facultyProfileId" asp-items="Model.FacultyOptions" required><option value="">Select faculty</option></select></label>
        <label><span>Academic term</span><select name="academicPeriodId" asp-items="Model.AcademicPeriodOptions" required><option value="">Select term</option></select></label>
        <label><span>Section</span><input name="section" value="A" maxlength="30" required /></label>
        <button class="admin-primary-button" type="submit"><i class="bi bi-person-plus"></i>Assign</button>
    </form>
    @if (Model.FacultyAssignments.Count == 0)
    {
        <div class="admin-empty"><i class="bi bi-person-workspace"></i><p>No faculty has been assigned to this course.</p></div>
    }
    else
    {
        <div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>Faculty</th><th>Department</th><th>Term</th><th>Section</th><th></th></tr></thead><tbody>
        @foreach (var assignment in Model.FacultyAssignments)
        {
            <tr><td data-label="Faculty"><strong>@assignment.FacultyName</strong><small class="d-block text-muted">@assignment.FacultyId</small></td><td data-label="Department">@assignment.Department</td><td data-label="Term">@assignment.Period</td><td data-label="Section"><span class="admin-status-pill @(assignment.IsActive ? "active" : "inactive")"><i></i>@assignment.Section · @(assignment.IsActive ? "Active" : "Inactive")</span></td><td class="admin-table-actions"><form asp-action="SetFacultyAssignmentStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="assignmentId" value="@assignment.Id" /><input type="hidden" name="isActive" value="@(!assignment.IsActive)" /><button class="@(assignment.IsActive ? "admin-icon-danger" : "admin-primary-button")" type="submit" title="@(assignment.IsActive ? "Deactivate" : "Activate") assignment"><i class="bi @(assignment.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i></button></form></td></tr>
        }
        </tbody></table></div>
    }
</section>
