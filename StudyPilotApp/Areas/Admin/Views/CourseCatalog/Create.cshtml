@model CourseCatalogFormViewModel
@{ ViewData["Title"] = "Add Catalog Course"; }
<section class="admin-page-heading compact"><div><a class="admin-back-link" asp-action="Index"><i class="bi bi-arrow-left"></i>Course catalog</a><h1>Add catalog course</h1><p>Create an official course definition for academic planning.</p></div></section>
<form asp-action="Create" method="post" class="admin-form-panel"><header><span><i class="bi bi-journal-plus"></i></span><div><h2>Course information</h2><p>Course code must be unique across StudyPilot.</p></div></header><div class="admin-form-body"><partial name="_CourseCatalogForm" model="Model" /></div><footer><a class="admin-secondary-button" asp-action="Index">Cancel</a><button class="admin-primary-button" type="submit"><i class="bi bi-check-lg"></i>Create catalog course</button></footer></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/admin-course-catalog.js" asp-append-version="true"></script> }
