@model AnnouncementDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var campusOffset = TimeSpan.FromHours(6);
}
<section class="admin-page-heading">
    <div><a class="admin-back-link" asp-action="Index"><i class="bi bi-arrow-left"></i>Announcements</a><h1>@Model.Title</h1><p>Review audience, delivery and publication information.</p></div>
    <div class="admin-heading-actions"><a class="admin-secondary-button" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i>Edit</a><form asp-action="SetPublished" asp-route-id="@Model.Id" method="post"><input type="hidden" name="isPublished" value="@(!Model.IsPublished)" /><button class="@(Model.IsPublished ? "admin-secondary-button" : "admin-primary-button")" type="submit"><i class="bi @(Model.IsPublished ? "bi-eye-slash" : "bi-send-check")"></i>@(Model.IsPublished ? "Unpublish" : "Publish now")</button></form><form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this announcement draft permanently?');"><button class="admin-danger-button" type="submit"><i class="bi bi-trash3"></i>Delete</button></form></div>
</section>
<div class="admin-details-grid">
    <section class="admin-panel admin-announcement-hero priority-@Model.Priority.ToString().ToLowerInvariant()"><div class="admin-announcement-icon"><i class="bi bi-megaphone-fill"></i></div><div><div class="admin-announcement-badges"><span class="admin-status-pill @Model.StatusClass"><i></i>@Model.DisplayStatus</span><span class="admin-priority-chip @Model.Priority.ToString().ToLowerInvariant()">@Model.Priority</span><span class="admin-audience-chip"><i class="bi bi-people"></i>@Model.Audience</span></div><h2>@Model.Title</h2><p>@Model.Summary</p></div></section>
    <aside class="admin-panel admin-record-meta"><h2>Delivery information</h2><dl><div><dt>Target audience</dt><dd>@Model.Audience</dd></div><div><dt>Notifications delivered</dt><dd>@Model.RecipientCount</dd></div><div><dt>Published</dt><dd>@(Model.PublishedAt?.ToOffset(campusOffset).ToString("dd MMM yyyy, h:mm tt") ?? "Not published")</dd></div><div><dt>Expires</dt><dd>@(Model.ExpiresAt?.ToOffset(campusOffset).ToString("dd MMM yyyy, h:mm tt") ?? "No expiry")</dd></div></dl></aside>
</div>
<section class="admin-panel admin-announcement-content"><header><div><h2>Full announcement</h2><p>This is the authoritative announcement content stored by StudyPilot.</p></div></header><div>@Model.Content</div></section>
@if (Model.DeliveredAt.HasValue)
{
    <div class="admin-info-callout"><i class="bi bi-bell-fill"></i><div><strong>Notification delivery completed</strong><p>Delivered @Model.DeliveredAt.Value.ToOffset(campusOffset).ToString("dd MMM yyyy, h:mm tt") to @Model.RecipientCount active @Model.Audience.ToString().ToLowerInvariant() recipient(s). Republishing will not create duplicate notifications.</p></div></div>
}
else
{
    <div class="admin-inline-warning"><i class="bi bi-info-circle"></i><div><strong>Not delivered yet</strong><p>Publish this announcement when it is ready. Until then, no Student or Faculty notification is created.</p></div></div>
}
<div class="admin-announcement-record-footer"><span>Created by <strong>@Model.CreatedByName</strong> on @Model.CreatedAt.ToOffset(campusOffset).ToString("dd MMM yyyy, h:mm tt")</span><span>Last updated: @(Model.UpdatedAt?.ToOffset(campusOffset).ToString("dd MMM yyyy, h:mm tt") ?? "Not updated yet")</span></div>
