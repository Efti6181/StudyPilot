@model AnnouncementFormViewModel
<div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>
<div class="admin-form-grid">
    <div class="admin-field admin-field-full"><label asp-for="Title"></label><input asp-for="Title" maxlength="180" placeholder="Clear announcement title" /><span asp-validation-for="Title"></span></div>
    <div class="admin-field admin-field-full"><label asp-for="Summary"></label><textarea asp-for="Summary" rows="3" maxlength="320" placeholder="Short message delivered to recipient notifications."></textarea><div class="admin-field-meta"><span asp-validation-for="Summary"></span><small>Maximum 320 characters</small></div></div>
    <div class="admin-field"><label asp-for="Audience"></label>@if(Model.AudienceLocked){<input asp-for="Audience" type="hidden" /><div class="admin-locked-value"><i class="bi bi-lock"></i>@Model.Audience</div><small>Audience is locked after notification delivery.</small>}else{<select asp-for="Audience">@foreach(var audience in Enum.GetValues<AnnouncementAudience>()){<option value="@((int)audience)">@audience</option>}</select>}<span asp-validation-for="Audience"></span></div>
    <div class="admin-field"><label asp-for="Priority"></label><select asp-for="Priority">@foreach(var priority in Enum.GetValues<AnnouncementPriority>()){<option value="@((int)priority)">@priority</option>}</select><span asp-validation-for="Priority"></span></div>
    <div class="admin-field admin-field-full"><label asp-for="ExpiresAt"></label><input asp-for="ExpiresAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><span asp-validation-for="ExpiresAt"></span><small>Bangladesh Standard Time (UTC+6). Leave empty for no expiry.</small></div>
    <div class="admin-field admin-field-full"><label asp-for="Content"></label><textarea asp-for="Content" rows="9" maxlength="5000" placeholder="Full announcement details, instructions and relevant information."></textarea><div class="admin-field-meta"><span asp-validation-for="Content"></span><small>Maximum 5,000 characters</small></div></div>
    <div class="admin-field admin-field-full"><label class="admin-switch-row"><input asp-for="IsPublished" /><span class="admin-switch-control"></span><span><strong>Publish and notify recipients</strong><small>First publication creates one in-app notification for every active account in the selected audience. Republishing does not send duplicates.</small></span></label></div>
</div>
