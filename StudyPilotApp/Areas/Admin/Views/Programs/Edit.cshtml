@model AcademicProgramFormViewModel
@{
    ViewData["Title"] = "Edit Program";
}

<section class="admin-page-heading compact"><div><a class="admin-back-link" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i>Program details</a><h1>Edit @Model.Code</h1><p>Update this Program while preserving its stable database identity.</p></div></section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form-panel">
    <input asp-for="Id" type="hidden" />
    <header><span><i class="bi bi-pencil-square"></i></span><div><h2>Program information</h2><p>Relationship and academic changes are validated on the server.</p></div></header>
    <div class="admin-form-body"><partial name="_ProgramForm" model="Model" /></div>
    <footer><a class="admin-secondary-button" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="admin-primary-button" type="submit"><i class="bi bi-check-lg"></i>Save changes</button></footer>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
