@model AcademicProgramDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<section class="admin-page-heading">
    <div><a class="admin-back-link" asp-action="Index"><i class="bi bi-arrow-left"></i>Programs</a><h1>@Model.Name</h1><p>Review this Program and its Department relationship.</p></div>
    <div class="admin-heading-actions"><a class="admin-secondary-button" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i>Edit</a><form asp-action="SetStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="isActive" value="@(!Model.IsActive)" /><button class="@(Model.IsActive ? "admin-danger-button" : "admin-primary-button")" type="submit"><i class="bi @(Model.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>@(Model.IsActive ? "Deactivate" : "Activate")</button></form></div>
</section>

<div class="admin-details-grid">
    <section class="admin-panel admin-department-hero"><span class="admin-department-code admin-program-code">@Model.Code</span><div><span class="admin-status-pill @(Model.IsActive ? "active" : "inactive")"><i></i>@(Model.IsActive ? "Active" : "Inactive")</span><h2>@Model.Name</h2><a class="admin-detail-department" asp-area="Admin" asp-controller="Departments" asp-action="Details" asp-route-id="@Model.DepartmentId"><i class="bi bi-building"></i>@Model.DepartmentCode — @Model.DepartmentName</a><p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No program description has been provided." : Model.Description)</p><div class="admin-program-facts"><span><small>Total credits</small><strong>@Model.TotalCredits.ToString("0.#")</strong></span><span><small>Duration</small><strong>@Model.DurationYears.ToString("0.#") years</strong></span></div></div></section>
    <aside class="admin-panel admin-record-meta"><h2>Record information</h2><dl><div><dt>Program ID</dt><dd>#@Model.Id</dd></div><div><dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</dd></div><div><dt>Last updated</dt><dd>@(Model.UpdatedAt?.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") ?? "Not updated yet")</dd></div></dl></aside>
</div>

<section class="admin-info-callout"><i class="bi bi-person-check"></i><div><strong>Next integration: Registration Authorization</strong><p>Student and Faculty authorization records will use centralized Department and Program selections instead of repeated free text.</p></div></section>
