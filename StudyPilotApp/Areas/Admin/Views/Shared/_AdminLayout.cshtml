@model StudyPilotApp.Areas.Admin.ViewModels.AdminShellViewModel
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="StudyPilot administration portal." />
    <title>@ViewData["Title"] - StudyPilot Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="admin-brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                <span>StudyPilot<small>Administration</small></span>
            </a>

            <nav class="admin-nav" aria-label="Admin navigation">
                <span class="admin-nav-label">Dashboard</span>
                <a class="admin-nav-link @(controller == "Dashboard" ? "active" : null)" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Overview</span>
                </a>

                <span class="admin-nav-label">User management</span>
                <a class="admin-nav-link @(controller == "Users" ? "active" : null)" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i><span>Users</span>
                </a>
                <a class="admin-nav-link @(controller == "RegistrationAuthorizations" ? "active" : null)" asp-area="Admin" asp-controller="RegistrationAuthorizations" asp-action="Index">
                    <i class="bi bi-person-check"></i><span>Registration Authorization</span>
                </a>

                <span class="admin-nav-label">Academics</span>
                <a class="admin-nav-link @(controller == "Departments" ? "active" : null)" asp-area="Admin" asp-controller="Departments" asp-action="Index">
                    <i class="bi bi-building"></i><span>Departments</span>
                </a>
                <a class="admin-nav-link @(controller == "Programs" ? "active" : null)" asp-area="Admin" asp-controller="Programs" asp-action="Index">
                    <i class="bi bi-diagram-3"></i><span>Programs</span>
                </a>
                <a class="admin-nav-link @(controller == "AcademicPeriods" ? "active" : null)" asp-area="Admin" asp-controller="AcademicPeriods" asp-action="Index">
                    <i class="bi bi-calendar3"></i><span>Academic Terms</span>
                </a>
                <a class="admin-nav-link @(controller == "CourseCatalog" ? "active" : null)" asp-area="Admin" asp-controller="CourseCatalog" asp-action="Index">
                    <i class="bi bi-journal-bookmark"></i><span>Course Catalog</span>
                </a>

                <span class="admin-nav-label">Campus &amp; content</span>
                <a class="admin-nav-link @(controller == "Events" ? "active" : null)" asp-area="Admin" asp-controller="Events" asp-action="Index">
                    <i class="bi bi-calendar-event"></i><span>Events</span>
                </a>
                <a class="admin-nav-link @(controller == "Announcements" ? "active" : null)" asp-area="Admin" asp-controller="Announcements" asp-action="Index">
                    <i class="bi bi-megaphone"></i><span>Announcements</span>
                </a>
                <a class="admin-nav-link @(controller == "Moderation" ? "active" : null)" asp-area="Admin" asp-controller="Moderation" asp-action="Index">
                    <i class="bi bi-shield-check"></i><span>Moderation</span>
                </a>

                <span class="admin-nav-label">System</span>
                <a class="admin-nav-link @(controller == "Reports" ? "active" : null)" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i><span>Reports</span></a>
                <a class="admin-nav-link @(controller == "AuditLogs" ? "active" : null)" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-clock-history"></i><span>Audit Logs</span></a>
                <a class="admin-nav-link @(controller == "Settings" ? "active" : null)" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i><span>Settings</span></a>
            </nav>

            <div class="admin-user-card">
                <span class="admin-avatar">@Model.Initials</span>
                <span class="admin-user-copy"><strong>@Model.FullName</strong><small>Administrator</small></span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="admin-logout" aria-label="Sign out" title="Sign out"><i class="bi bi-box-arrow-right"></i></button>
                </form>
            </div>
        </aside>

        <div class="admin-backdrop" id="adminBackdrop"></div>

        <div class="admin-main">
            <header class="admin-topbar">
                <button class="admin-icon-button admin-menu-button" id="adminMenuButton" type="button" aria-label="Open navigation"><i class="bi bi-list"></i></button>
                <div class="admin-topbar-title"><strong>Administration Portal</strong><small>Institutional operations and oversight</small></div>
                <div class="admin-topbar-actions">
                    <span class="admin-secure-badge"><i class="bi bi-shield-lock"></i>Admin only</span>
                    <button class="admin-icon-button" id="adminThemeButton" type="button" aria-label="Switch color theme"><i class="bi bi-moon-stars"></i></button>
                    <span class="admin-top-avatar">@Model.Initials</span>
                </div>
            </header>

            <main class="admin-content">
                @if (TempData["AdminSuccess"] is string successMessage)
                {
                    <div class="admin-flash success" role="status"><i class="bi bi-check-circle-fill"></i><span>@successMessage</span></div>
                }
                @if (TempData["AdminError"] is string errorMessage)
                {
                    <div class="admin-flash error" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><span>@errorMessage</span></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
