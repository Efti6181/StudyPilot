@model StudyPilotApp.ViewModels.CommunityPostFormViewModel
@{
    ViewData["Title"] = "Create Community Post";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
}
@section Styles { <link rel="stylesheet" href="~/css/community.css" asp-append-version="true" /> }

<div class="page-heading">
    <div><h1>Create a post</h1><p>Ask for help, share an idea or start a useful academic discussion.</p></div>
    <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-2"></i>Community</a>
</div>

<section class="card-ui community-form-card">
    <div class="card-body-ui">
        <form asp-action="Create" method="post">
            <partial name="_PostForm" model="Model" />
            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                <button class="btn btn-primary" type="submit"><i class="bi bi-send me-2"></i>Publish Post</button>
            </div>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
