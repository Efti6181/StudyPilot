@model FacultyResourceFormViewModel
@{ ViewData["Title"] = "Edit Resource"; Layout = "/Views/Shared/_FacultyLayout.cshtml"; }
<section class="faculty-heading"><div><a class="faculty-back" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i>Resource details</a><h1>Edit resource</h1><p>@(Model.CurrentStatus == FacultyResourceStatus.Published ? "Changes will also update existing student copies." : "Review the draft before publishing it.")</p></div></section>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="faculty-panel faculty-assessment-form">
    @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
    <header><div><h2>Resource details</h2><p>Status: @Model.CurrentStatus</p></div></header>
    <partial name="_Form" model="Model" />
    <footer><a class="faculty-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="faculty-primary" type="submit"><i class="bi bi-check2"></i>Save changes</button></footer>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
