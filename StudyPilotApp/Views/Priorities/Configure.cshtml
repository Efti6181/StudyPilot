@model StudyPilotApp.ViewModels.PriorityConfigureViewModel
@{ ViewData["Title"] = "Configure Priority"; Layout = "/Views/Shared/_StudentLayout.cshtml"; }

<div class="page-heading"><div><h1>Configure @Model.CourseCode</h1><p>@Model.CourseName · adjust the student-controlled priority evidence.</p></div><a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-ghost"><i class="bi bi-arrow-left me-2"></i>Back</a></div>

<div class="row g-4">
    <div class="col-xl-8"><section class="card-ui"><div class="card-head"><div><h2>Priority inputs</h2><p>Deadlines, marks and credits remain automatic.</p></div></div><div class="card-body-ui">
        <form asp-action="Configure" asp-route-id="@Model.CourseId" method="post">
            <input asp-for="CourseId" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4"></div>
            <div class="priority-setting-row"><div><label asp-for="ConfidenceRating" class="form-label"></label><p>1 means very low confidence; 5 means fully confident.</p></div><div class="range-control"><input asp-for="ConfidenceRating" type="range" min="1" max="5" class="form-range priority-range" /><output>@Model.ConfidenceRating / 5</output></div></div>
            <div class="priority-setting-row"><div><label asp-for="TopicCompletionPercentage" class="form-label"></label><p>Estimate how much of this course's current topics you have completed.</p></div><div class="range-control"><input asp-for="TopicCompletionPercentage" type="range" min="0" max="100" class="form-range priority-range" /><output>@Model.TopicCompletionPercentage%</output></div></div>
            <div class="priority-setting-row"><div><label asp-for="WorkloadRisk" class="form-label"></label><p>1 means manageable; 5 means overloaded or at risk.</p></div><div class="range-control"><input asp-for="WorkloadRisk" type="range" min="1" max="5" class="form-range priority-range" /><output>@Model.WorkloadRisk / 5</output></div></div>
            <div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="AvailableStudyHoursPerWeek" class="form-label"></label><div class="input-group"><input asp-for="AvailableStudyHoursPerWeek" class="form-control" type="number" min="0" max="168" step="0.5" /><span class="input-group-text">hours</span></div><span asp-validation-for="AvailableStudyHoursPerWeek" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="ManualPriorityLevel" class="form-label"></label><select asp-for="ManualPriorityLevel" asp-items="Html.GetEnumSelectList<StudyPilotApp.Models.PriorityLevel>()" class="form-select"><option value="">Use calculated level</option></select><span asp-validation-for="ManualPriorityLevel" class="text-danger small"></span></div><div class="col-12"><div class="form-check form-switch"><input asp-for="IsPinned" class="form-check-input" /><label asp-for="IsPinned" class="form-check-label"></label></div></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="4" maxlength="500" placeholder="Why this course needs attention…"></textarea><span asp-validation-for="Notes" class="text-danger small"></span></div></div>
            <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-ghost">Cancel</a><button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-2"></i>Save Priority Inputs</button></div>
        </form>
    </div></section></div>
    <div class="col-xl-4"><section class="card-ui"><div class="card-head"><div><h2>Live evidence</h2><p>Read-only database signals</p></div></div><div class="card-body-ui"><div class="data-pair"><span>Course progress</span><strong>@Model.CourseProgress%</strong></div><div class="data-pair"><span>Pending assessments</span><strong>@Model.PendingAssessments</strong></div><div class="data-pair"><span>Nearest deadline</span><strong>@(Model.NearestDeadline?.ToString("dd MMM yyyy") ?? "None")</strong></div><div class="data-pair"><span>Assessment average</span><strong>@(Model.AssessmentAverage.HasValue ? $"{Model.AssessmentAverage.Value:0.#}%" : "No marked work")</strong></div></div></section><div class="gpa-note mt-3"><i class="bi bi-info-circle"></i><div><strong>Manual override</strong><p>An override changes the displayed level but keeps the calculated score visible for transparency.</p></div></div></div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/priorities.js" asp-append-version="true"></script> }
