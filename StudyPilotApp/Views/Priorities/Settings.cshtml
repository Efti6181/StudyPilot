@model StudyPilotApp.ViewModels.PriorityWeightSettingsViewModel
@{ ViewData["Title"] = "Priority Engine Weights"; Layout = "/Views/Shared/_StudentLayout.cshtml"; }

<div class="page-heading"><div><h1>Priority Engine Weights</h1><p>Control how strongly each verified factor influences course ranking.</p></div><a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-2"></i>Priorities</a></div>
@if (TempData["PrioritySuccess"] is string message) { <div class="alert alert-success rounded-4"><i class="bi bi-check-circle me-2"></i>@message</div> }

<div class="row g-4"><div class="col-xl-8"><section class="card-ui"><div class="card-head"><div><h2>Calculation weights</h2><p>The six values must total exactly 100%.</p></div><span class="weight-total @(Model.TotalWeight == 100m ? "valid" : "invalid")" id="weightTotal">@Model.TotalWeight.ToString("0.##")%</span></div><div class="card-body-ui">
    <form asp-action="Settings" method="post" id="priorityWeightsForm"><div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4"></div><div class="row g-3">
        <div class="col-md-6"><label asp-for="TargetGradeGapWeight" class="form-label"></label><div class="input-group"><input asp-for="TargetGradeGapWeight" class="form-control priority-weight" step="0.5" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="TargetGradeGapWeight" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="AssessmentUrgencyWeight" class="form-label"></label><div class="input-group"><input asp-for="AssessmentUrgencyWeight" class="form-control priority-weight" step="0.5" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="AssessmentUrgencyWeight" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="CourseCreditWeight" class="form-label"></label><div class="input-group"><input asp-for="CourseCreditWeight" class="form-control priority-weight" step="0.5" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="CourseCreditWeight" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="WeaknessWeight" class="form-label"></label><div class="input-group"><input asp-for="WeaknessWeight" class="form-control priority-weight" step="0.5" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="WeaknessWeight" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="IncompleteTopicsWeight" class="form-label"></label><div class="input-group"><input asp-for="IncompleteTopicsWeight" class="form-control priority-weight" step="0.5" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="IncompleteTopicsWeight" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="WorkloadRiskWeight" class="form-label"></label><div class="input-group"><input asp-for="WorkloadRiskWeight" class="form-control priority-weight" step="0.5" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="WorkloadRiskWeight" class="text-danger small"></span></div>
    </div><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-ghost">Cancel</a><button class="btn btn-primary" type="submit"><i class="bi bi-check2-circle me-2"></i>Save Weights</button></div></form>
</div></section></div><div class="col-xl-4"><div class="gpa-note"><i class="bi bi-shield-check"></i><div><strong>Explainable ranking</strong><p>Every factor and weight remains visible. AI cannot calculate or silently change these scores.</p></div></div><div class="card-ui mt-3"><div class="card-body-ui"><strong class="d-block mb-2">Default formula</strong><p class="text-muted small mb-0">30% grade gap + 20% urgency + 15% credits + 15% weakness + 10% incomplete topics + 10% workload risk.</p></div></div></div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/priorities.js" asp-append-version="true"></script> }
