@model FacultyAssessmentIndexViewModel
@{ViewData["Title"]="Assessments";Layout="/Views/Shared/_FacultyLayout.cshtml";}
<section class="faculty-heading"><div><span>ACADEMICS</span><h1>Assessment Management</h1><p>Create, review, and publish coursework for your assigned courses.</p></div><a class="faculty-primary" asp-action="Create"><i class="bi bi-plus-lg"></i>Create assessment</a></section>
<section class="faculty-panel"><form method="get" class="faculty-filters"><label><i class="bi bi-search"></i><input name="search" value="@Model.Search" placeholder="Search title or course" /></label><select asp-for="AssignmentId"><option value="">All courses</option>@foreach(var c in Model.Courses){<option value="@c.AssignmentId">@c.Label</option>}</select><select asp-for="Status" asp-items="Html.GetEnumSelectList<FacultyAssessmentStatus>()"><option value="">All statuses</option></select><button class="faculty-secondary" type="submit">Filter</button></form>
@if(Model.Items.Count==0){<div class="faculty-empty"><i class="bi bi-clipboard2-x"></i><h3>No assessments found</h3><p>Create a draft for one of your assigned courses.</p></div>}else{<div class="faculty-assessment-list">@foreach(var x in Model.Items){<a asp-action="Details" asp-route-id="@x.Id"><span class="faculty-assessment-date"><strong>@x.DueDate.ToString("dd")</strong><small>@x.DueDate.ToString("MMM")</small></span><div><span class="faculty-status @x.Status.ToString().ToLowerInvariant()">@x.Status</span><h2>@x.Title</h2><p>@x.CourseCode · @x.Term @x.AcademicYear · Section @x.Section</p></div><aside><strong>@x.StudentCount</strong><small>student copies</small></aside><i class="bi bi-chevron-right"></i></a>}</div>}</section>
