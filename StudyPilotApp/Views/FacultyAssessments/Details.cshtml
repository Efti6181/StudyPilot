@model FacultyAssessmentDetailsViewModel
@{ViewData["Title"]=Model.Assessment.Title;Layout="/Views/Shared/_FacultyLayout.cshtml";var x=Model.Assessment;var a=x.FacultyCourseAssignment;}
<section class="faculty-heading"><div><a class="faculty-back" asp-action="Index"><i class="bi bi-arrow-left"></i>Assessments</a><h1>@x.Title</h1><p>@a.CatalogCourse.Code · @a.AcademicPeriod.Term @a.AcademicPeriod.AcademicYear · Section @a.Section</p></div><div class="faculty-heading-actions">@if(x.Status!=FacultyAssessmentStatus.Closed){<a class="faculty-secondary" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-pencil"></i>Edit</a>}@if(x.Status==FacultyAssessmentStatus.Draft){<form asp-action="Publish" asp-route-id="@x.Id" method="post"><button class="faculty-primary" type="submit"><i class="bi bi-send"></i>Publish</button></form>}@if(x.Status==FacultyAssessmentStatus.Published){<form asp-action="Close" asp-route-id="@x.Id" method="post"><button class="faculty-secondary" type="submit">Close</button></form>}</div></section>
<div class="faculty-course-detail-grid"><section class="faculty-panel faculty-assessment-detail"><div class="faculty-tags"><em>@x.Status</em><em>@x.Type</em><em>@x.Difficulty</em></div><h2>Description</h2><p>@(x.Description??"No description provided.")</p><h2>Instructions</h2><p>@(x.Instructions??"No special instructions provided.")</p>@if(x.AttachmentData is not null){<a class="faculty-secondary" asp-action="Attachment" asp-route-id="@x.Id"><i class="bi bi-paperclip"></i>@x.AttachmentFileName</a>}</section><aside class="faculty-panel faculty-course-meta"><h2>Publishing information</h2><dl><div><dt>Assigned</dt><dd>@x.AssignedDate.ToString("dd MMM yyyy")</dd></div><div><dt>Deadline</dt><dd>@x.DueDate.ToString("dd MMM yyyy, h:mm tt")</dd></div><div><dt>Total marks</dt><dd>@(x.TotalMarks?.ToString("0.##")??"Not set")</dd></div><div><dt>Weight</dt><dd>@(x.WeightPercentage.HasValue?$"{x.WeightPercentage:0.##}%":"Not set")</dd></div><div><dt>Student copies</dt><dd>@Model.StudentCount</dd></div></dl>@if(x.Status==FacultyAssessmentStatus.Draft){<form asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="faculty-danger" type="submit"><i class="bi bi-trash"></i>Delete draft</button></form>}</aside></div>
