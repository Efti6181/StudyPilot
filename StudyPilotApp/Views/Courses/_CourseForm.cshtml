@model StudyPilotApp.ViewModels.CourseFormViewModel

@if (Model.Id.HasValue)
{
    <input asp-for="Id" type="hidden" />
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4" role="alert"></div>

<section class="card-ui mb-3">
    <div class="card-head">
        <div>
            <h2>Course identity</h2>
            <p>The code, title and instructor shown throughout StudyPilot</p>
        </div>
    </div>
    <div class="card-body-ui">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CourseCode" class="form-label"></label>
                <input asp-for="CourseCode" class="form-control text-uppercase" placeholder="CSE 3205" autocomplete="off" />
                <span asp-validation-for="CourseCode" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="CourseName" class="form-label"></label>
                <input asp-for="CourseName" class="form-control" placeholder="Computer Networks" autocomplete="off" />
                <span asp-validation-for="CourseName" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Instructor" class="form-label"></label>
                <input asp-for="Instructor" class="form-control" placeholder="Instructor name (optional)" autocomplete="off" />
                <span asp-validation-for="Instructor" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CourseType" class="form-label"></label>
                <select asp-for="CourseType" asp-items="Html.GetEnumSelectList<CourseType>()" class="form-select">
                    <option value="">Select type</option>
                </select>
                <span asp-validation-for="CourseType" class="text-danger small"></span>
            </div>
        </div>
    </div>
</section>

<section class="card-ui mb-3">
    <div class="card-head">
        <div>
            <h2>Academic placement</h2>
            <p>Where this course belongs in your academic timeline</p>
        </div>
    </div>
    <div class="card-body-ui">
        <div class="row g-3">
            <div class="col-sm-6 col-xl-3">
                <label asp-for="CreditHours" class="form-label"></label>
                <input asp-for="CreditHours" class="form-control" type="number" min="0.5" max="9" step="0.5" placeholder="3.0" />
                <span asp-validation-for="CreditHours" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label asp-for="Semester" class="form-label"></label>
                <select asp-for="Semester" class="form-select">
                    <option value="">Select semester</option>
                    @for (var semester = 1; semester <= 12; semester++)
                    {
                        <option value="@semester">Semester @semester</option>
                    }
                </select>
                <span asp-validation-for="Semester" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label asp-for="AcademicTerm" class="form-label"></label>
                <select asp-for="AcademicTerm" asp-items="Html.GetEnumSelectList<AcademicTerm>()" class="form-select">
                    <option value="">Select term</option>
                </select>
                <span asp-validation-for="AcademicTerm" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label asp-for="AcademicYear" class="form-label"></label>
                <input asp-for="AcademicYear" class="form-control" type="number" min="2000" max="2100" />
                <span asp-validation-for="AcademicYear" class="text-danger small"></span>
            </div>
        </div>
    </div>
</section>

<section class="card-ui mb-3">
    <div class="card-head">
        <div>
            <h2>Goal and progress</h2>
            <p>Set the outcome you want and track current completion</p>
        </div>
    </div>
    <div class="card-body-ui">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="TargetGrade" class="form-label"></label>
                <select asp-for="TargetGrade" class="form-select">
                    <option value="">No target yet</option>
                    @foreach (var grade in new[] { "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "D", "F" })
                    {
                        <option value="@grade">@grade</option>
                    }
                </select>
                <span asp-validation-for="TargetGrade" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<CourseStatus>()" class="form-select">
                    <option value="">Select status</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Color" class="form-label"></label>
                <select asp-for="Color" asp-items="Html.GetEnumSelectList<CourseColor>()" class="form-select">
                    <option value="">Select color</option>
                </select>
                <span asp-validation-for="Color" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ProgressPercentage" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ProgressPercentage" class="form-control" type="number" min="0" max="100" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="ProgressPercentage" class="text-danger small"></span>
            </div>
        </div>
    </div>
</section>

<section class="card-ui">
    <div class="card-head">
        <div>
            <h2>Course description</h2>
            <p>Optional notes about topics, outcomes or expectations</p>
        </div>
    </div>
    <div class="card-body-ui">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5" maxlength="1000" placeholder="What will you learn in this course?"></textarea>
        <div class="d-flex justify-content-between mt-1">
            <span asp-validation-for="Description" class="text-danger small"></span>
            <small class="text-muted"><span id="courseDescriptionCount">0</span>/1000</small>
        </div>
    </div>
</section>
