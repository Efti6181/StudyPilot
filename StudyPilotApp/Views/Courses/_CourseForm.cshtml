@using System.Globalization
@model StudyPilotApp.ViewModels.CourseFormViewModel

@if (Model.Id.HasValue)
{
    <input asp-for="Id" type="hidden" />
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4" role="alert"></div>

<section class="card-ui mb-3">
    <div class="card-head">
        <div>
            <h2>Admin-approved course and instructor</h2>
            <p>Course facts come from the Course Catalog. Choose an instructor assigned by an administrator.</p>
        </div>
        <span class="mini-badge success"><i class="bi bi-shield-lock"></i> Verified catalog data</span>
    </div>
    <div class="card-body-ui">
        @if (Model.CatalogOptions.Count == 0 && !Model.IsCatalogLocked)
        {
            <div class="alert alert-warning rounded-4 mb-3">
                No eligible course is available. First select your Admin-managed Department and Program in
                <a asp-controller="Student" asp-action="Profile" class="alert-link">My Profile</a>, then ask an administrator to assign Faculty to the course.
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-6">
                <label asp-for="CatalogCourseId" class="form-label"></label>
                @if (Model.IsCatalogLocked)
                {
                    <input asp-for="CatalogCourseId" type="hidden" />
                    <select class="form-select" disabled aria-label="Catalog course is locked">
                        <option>@Model.CourseCode — @Model.CourseName</option>
                    </select>
                }
                else
                {
                    <select asp-for="CatalogCourseId" class="form-select"
                            data-instructors-url="@Url.Action("Instructors", "Courses")">
                        <option value="">Select course</option>
                        @foreach (var course in Model.CatalogOptions)
                        {
                            <option value="@course.Id"
                                    data-code="@course.Code"
                                    data-name="@course.Name"
                                    data-credit="@course.CreditHours.ToString(CultureInfo.InvariantCulture)"
                                    data-type="@course.CourseType"
                                    data-semester="@course.Semester"
                                    data-description="@course.Description">@course.Label</option>
                        }
                    </select>
                }
                <span asp-validation-for="CatalogCourseId" class="text-danger small"></span>
            </div>
            <div class="col-lg-6">
                <label asp-for="FacultyCourseAssignmentId" class="form-label"></label>
                @if (Model.IsCatalogLocked)
                {
                    <input asp-for="FacultyCourseAssignmentId" type="hidden" />
                    <select class="form-select" disabled aria-label="Instructor is locked">
                        <option>@Model.Instructor · @Model.AcademicTerm @Model.AcademicYear</option>
                    </select>
                }
                else
                {
                    <select asp-for="FacultyCourseAssignmentId" asp-items="Model.InstructorOptions" class="form-select">
                        <option value="">Select instructor</option>
                    </select>
                }
                <span asp-validation-for="FacultyCourseAssignmentId" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6 col-xl-3">
                <label asp-for="CourseCode" class="form-label"></label>
                <input asp-for="CourseCode" class="form-control" readonly />
            </div>
            <div class="col-md-6 col-xl-5">
                <label asp-for="CourseName" class="form-label"></label>
                <input asp-for="CourseName" class="form-control" readonly />
            </div>
            <div class="col-6 col-xl-2">
                <label asp-for="CreditHours" class="form-label"></label>
                <input asp-for="CreditHours" class="form-control" readonly />
            </div>
            <div class="col-6 col-xl-2">
                <label asp-for="CourseType" class="form-label"></label>
                <input id="CourseTypeDisplay" class="form-control" value="@Model.CourseType" readonly />
                <input asp-for="CourseType" type="hidden" />
            </div>
            <div class="col-md-4">
                <label asp-for="Semester" class="form-label"></label>
                <input asp-for="Semester" class="form-control" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="AcademicTerm" class="form-label"></label>
                <input id="AcademicTermDisplay" class="form-control" value="@Model.AcademicTerm" readonly />
                <input asp-for="AcademicTerm" type="hidden" />
            </div>
            <div class="col-md-4">
                <label asp-for="AcademicYear" class="form-label"></label>
                <input asp-for="AcademicYear" class="form-control" readonly />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" readonly></textarea>
                <div class="form-text">Only an administrator can change these catalog details.</div>
            </div>
        </div>
    </div>
</section>

<section class="card-ui">
    <div class="card-head">
        <div>
            <h2>Your goal and progress</h2>
            <p>These are your personal settings and remain editable.</p>
        </div>
    </div>
    <div class="card-body-ui">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="TargetGrade" class="form-label"></label>
                <select asp-for="TargetGrade" class="form-select">
                    <option value="">No target yet</option>
                    @foreach (var grade in new[] { "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "D", "F" })
                    {
                        <option value="@grade">@grade</option>
                    }
                </select>
                <span asp-validation-for="TargetGrade" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<CourseStatus>()" class="form-select">
                    <option value="">Select status</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Color" class="form-label"></label>
                <select asp-for="Color" asp-items="Html.GetEnumSelectList<CourseColor>()" class="form-select">
                    <option value="">Select color</option>
                </select>
                <span asp-validation-for="Color" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ProgressPercentage" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ProgressPercentage" class="form-control" type="number" min="0" max="100" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="ProgressPercentage" class="text-danger small"></span>
            </div>
        </div>
    </div>
</section>
