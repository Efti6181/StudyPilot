@model StudyPilotApp.ViewModels.CourseFormViewModel
@{
    ViewData["Title"] = "Edit Course";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
}

<div class="page-heading">
    <div>
        <h1>Edit @Model.CourseCode</h1>
        <p>Update the permitted information for this course workspace.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">
            <i class="bi bi-arrow-left me-2"></i>Course details
        </a>
    </div>
</div>

<form asp-controller="Courses" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
    <partial name="_CourseForm" model="Model" />
    <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle me-2"></i>Save Changes
        </button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/courses.js" asp-append-version="true"></script>
}
