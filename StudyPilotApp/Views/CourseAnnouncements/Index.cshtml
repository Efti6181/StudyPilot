@model CourseAnnouncementIndexViewModel
@{ ViewData["Title"] = "Course Announcements"; Layout = "/Views/Shared/_StudentLayout.cshtml"; }
@section Styles { <link rel="stylesheet" href="~/css/course-announcements.css" asp-append-version="true" /> }
<div class="page-heading"><div><h1>Course Announcements</h1><p>Important updates published by your Faculty.</p></div><div class="announcement-unread"><i class="bi bi-envelope"></i><strong>@Model.UnreadCount</strong><span>unread</span></div></div>
<section class="card-ui mb-4"><div class="card-body-ui"><form method="get" class="course-announcement-filters"><div><i class="bi bi-search"></i><input name="search" value="@Model.Search" class="form-control" placeholder="Search announcements or courses" /></div><select name="courseId" asp-items="Model.CourseOptions" class="form-select"><option value="">All courses</option></select><select asp-for="Priority" asp-items="Html.GetEnumSelectList<AnnouncementPriority>()" class="form-select"><option value="">All priorities</option></select><label><input asp-for="ActiveOnly" type="checkbox" /><span>Active only</span></label><button class="btn btn-primary" type="submit">Apply</button><a class="btn btn-ghost" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i></a></form></div></section>
@if(Model.Items.Count == 0){<section class="card-ui empty-module-state"><div class="empty-icon"><i class="bi bi-megaphone"></i></div><h2>No announcements found</h2><p>New course updates from your Faculty will appear here.</p></section>}
else{<section class="course-announcement-grid">@foreach(var item in Model.Items){<a asp-action="Details" asp-route-id="@item.RecipientId" class="priority-@item.Priority.ToString().ToLowerInvariant() @(item.IsRead ? "is-read" : "is-unread")"><span class="announcement-icon"><i class="bi bi-megaphone"></i></span><div><header><span>@item.CourseCode</span><em>@item.Priority</em>@if(!item.IsRead){<b>New</b>}</header><h2>@item.Title</h2><p>@item.Summary</p><footer><span><i class="bi bi-person"></i>@item.FacultyName</span><time>@item.PublishedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy · h:mm tt")</time></footer></div><i class="bi bi-chevron-right"></i></a>}</section>}
