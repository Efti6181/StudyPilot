@model CourseAnnouncementDetailsViewModel
@{ ViewData["Title"] = Model.Announcement.Title; Layout = "/Views/Shared/_StudentLayout.cshtml"; var item = Model.Announcement; }
@section Styles { <link rel="stylesheet" href="~/css/course-announcements.css" asp-append-version="true" /> }
<div class="page-heading"><div><a asp-action="Index" class="btn btn-ghost mb-3"><i class="bi bi-arrow-left me-2"></i>Announcements</a><h1>@item.Title</h1><p>@item.CourseCode — @item.CourseName</p></div>@if(!item.IsRead){<form asp-action="MarkRead" asp-route-id="@item.RecipientId" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit"><i class="bi bi-check2-circle me-2"></i>Mark as read</button></form>}</div>
<article class="card-ui course-announcement-detail priority-@item.Priority.ToString().ToLowerInvariant()"><header><span class="announcement-icon"><i class="bi bi-megaphone"></i></span><div><span>@item.Priority priority</span><h2>@item.Title</h2><p>Published by @item.FacultyName · @item.PublishedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy, h:mm tt")</p></div></header><section><h3>Summary</h3><p>@item.Summary</p><h3>Full announcement</h3><p>@item.Content</p></section>@if(item.ExpiresAt.HasValue){<footer><i class="bi bi-clock"></i>Available until @item.ExpiresAt.Value.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy, h:mm tt")</footer>}</article>
