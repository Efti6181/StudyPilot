@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Create New Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<main class="sp-auth-page">
    <section class="sp-auth-shell sp-recovery-shell">
        <div class="sp-auth-visual">
            <a class="sp-brand" asp-controller="Home" asp-action="Index"><span class="sp-brand-mark">SP</span><span>StudyPilot<small>Academic success</small></span></a>
            <div class="sp-visual-copy"><span class="sp-kicker">Protect your account</span><h1>Create a stronger <em>new password.</em></h1><p>Your new password must meet StudyPilot’s Identity security policy.</p><ul class="sp-feature-list"><li><span>✓</span> Minimum 8 characters</li><li><span>✓</span> Uppercase and lowercase</li><li><span>✓</span> At least one number</li></ul></div>
            <small class="sp-copyright">© @DateTime.UtcNow.Year StudyPilot</small>
        </div>
        <div class="sp-auth-panel">
            <div class="sp-form-wrap">
                <div class="sp-mobile-brand"><span class="sp-brand-mark">SP</span> StudyPilot</div>
                <span class="sp-form-kicker">Secure reset</span><h2>Create new password</h2><p class="sp-form-intro">Choose a password you do not use on another website.</p>
                <form asp-action="ResetPassword" method="post" novalidate>
                    <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="sp-validation-summary"></div>
                    <div class="sp-field"><label asp-for="Password"></label><div class="sp-password-wrap"><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Create new password" data-password-strength autofocus /><button class="sp-password-toggle" type="button" data-password-toggle>Show</button></div><span asp-validation-for="Password"></span></div>
                    <div class="sp-password-strength" data-password-strength-panel aria-live="polite"><div><span data-password-strength-bar></span></div><p><span data-password-strength-label>Password strength</span><small>Use at least 8 characters with uppercase, lowercase and a number.</small></p></div>
                    <div class="sp-field"><label asp-for="ConfirmPassword"></label><div class="sp-password-wrap"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat new password" /><button class="sp-password-toggle" type="button" data-password-toggle>Show</button></div><span asp-validation-for="ConfirmPassword"></span></div>
                    <button type="submit" class="sp-primary-button">Update password <span>→</span></button>
                </form>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
