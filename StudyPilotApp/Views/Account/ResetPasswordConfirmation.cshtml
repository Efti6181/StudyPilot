@{
    ViewData["Title"] = "Password Updated";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<main class="sp-auth-page">
    <section class="sp-auth-message-card">
        <a class="sp-message-brand" asp-controller="Home" asp-action="Index"><span class="sp-brand-mark">SP</span><strong>StudyPilot</strong></a>
        <span class="sp-message-icon success"><i>✓</i></span>
        <span class="sp-form-kicker">Reset complete</span>
        <h1>Your password is updated</h1>
        <p>You can now sign in with your new password. Previous authentication sessions are no longer valid.</p>
        <a class="sp-primary-button" asp-action="Login">Sign in to StudyPilot <span>→</span></a>
    </section>
</main>
