@{
    ViewData["Title"] = "Access Denied";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}
<main class="sp-auth-page">
    <section class="sp-message-card">
        <span class="sp-brand-mark">SP</span>
        <span class="sp-form-kicker">Protected workspace</span>
        <h1>Access denied</h1>
