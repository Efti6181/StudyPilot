@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<main class="sp-auth-page">
    <section class="sp-auth-shell sp-recovery-shell">
        <div class="sp-auth-visual">
            <a class="sp-brand" asp-controller="Home" asp-action="Index"><span class="sp-brand-mark">SP</span><span>StudyPilot<small>Academic success</small></span></a>
            <div class="sp-visual-copy">
                <span class="sp-kicker">Secure account recovery</span>
                <h1>Return to your <em>academic journey.</em></h1>
                <p>StudyPilot uses a short-lived, single-use Identity token. Your existing password is never sent by email.</p>
                <ul class="sp-feature-list"><li><span>✓</span> Two-hour secure link</li><li><span>✓</span> Account privacy protection</li><li><span>✓</span> Existing sessions invalidated after reset</li></ul>
            </div>
            <small class="sp-copyright">© @DateTime.UtcNow.Year StudyPilot</small>
        </div>
        <div class="sp-auth-panel">
            <div class="sp-form-wrap">
                <div class="sp-mobile-brand"><span class="sp-brand-mark">SP</span> StudyPilot</div>
                <span class="sp-form-kicker">Account recovery</span>
                <h2>Reset your password</h2>
                <p class="sp-form-intro">Enter the email connected to your StudyPilot account.</p>
                <form asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="sp-validation-summary"></div>
                    <div class="sp-field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" placeholder="name@university.edu" autocomplete="email" autofocus /><span asp-validation-for="Email"></span></div>
                    <button type="submit" class="sp-primary-button">Send secure reset link <span>→</span></button>
                </form>
                <p class="sp-switch"><a asp-action="Login">← Return to sign in</a></p>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
