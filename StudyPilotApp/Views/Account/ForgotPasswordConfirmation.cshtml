@{
    ViewData["Title"] = "Check Your Email";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<main class="sp-auth-page">
    <section class="sp-auth-message-card">
        <a class="sp-message-brand" asp-controller="Home" asp-action="Index"><span class="sp-brand-mark">SP</span><strong>StudyPilot</strong></a>
        <span class="sp-message-icon"><i>✓</i></span>
        <span class="sp-form-kicker">Request received</span>
        <h1>Check your email</h1>
        <p>If an active StudyPilot account matches that address, a secure reset link has been sent. The link expires after two hours.</p>
        <div class="sp-security-note">For privacy, this page does not reveal whether an email is registered.</div>
        <a class="sp-primary-button" asp-action="Login">Return to sign in <span>→</span></a>
    </section>
</main>
