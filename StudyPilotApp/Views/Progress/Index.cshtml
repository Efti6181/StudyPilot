@model StudyPilotApp.ViewModels.ProgressDashboardViewModel
@{
    ViewData["Title"] = "Progress & Insights";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
    var chartData = new
    {
        snapshots = new
        {
            labels = Model.Snapshots.Select(x => x.SnapshotDate.ToString("dd MMM")),
            courseProgress = Model.Snapshots.Select(x => x.AverageCourseProgress),
            completionRate = Model.Snapshots.Select(x => x.AssessmentCompletionRate)
        },
        gpa = new
        {
            labels = Model.GpaTrend.Select(x => x.Label),
            values = Model.GpaTrend.Select(x => x.Gpa)
        },
        courses = new
        {
            labels = Model.Courses.Select(x => x.CourseCode),
            progress = Model.Courses.Select(x => x.ProgressPercentage),
            scores = Model.Courses.Select(x => x.AssessmentAverage)
        },
        assessmentStatus = new
        {
            completed = Model.Overview.CompletedAssessments,
            pending = Model.Overview.PendingAssessments,
            overdue = Model.Overview.OverdueAssessments
        },
        assessmentTypes = new
        {
            labels = Model.AssessmentTypes.Select(x => x.Type),
            scores = Model.AssessmentTypes.Select(x => x.AverageScore),
            completion = Model.AssessmentTypes.Select(x => x.Total == 0 ? 0 : Math.Round(x.Completed * 100m / x.Total, 2))
        }
    };
    var chartJson = System.Text.Json.JsonSerializer.Serialize(chartData);
}

<div class="page-heading">
    <div><h1>Progress &amp; Insights</h1><p>Understand momentum, mastery and the academic areas that need attention.</p></div>
    <div class="page-actions">
        <form asp-action="Index" method="get"><select name="period" class="form-select" onchange="this.form.submit()"><option value="30" selected="@(Model.PeriodDays == 30 ? "selected" : null)">Last 30 days</option><option value="90" selected="@(Model.PeriodDays == 90 ? "selected" : null)">Last 90 days</option><option value="180" selected="@(Model.PeriodDays == 180 ? "selected" : null)">Last 180 days</option><option value="365" selected="@(Model.PeriodDays == 365 ? "selected" : null)">Last year</option><option value="0" selected="@(Model.PeriodDays == 0 ? "selected" : null)">All snapshots</option></select></form>
        <form asp-action="SaveSnapshot" asp-route-period="@Model.PeriodDays" method="post"><button class="btn btn-primary" type="submit"><i class="bi bi-camera me-2"></i>Save Today's Snapshot</button></form>
    </div>
</div>

@if (TempData["ProgressSuccess"] is string message) { <div class="alert alert-success rounded-4"><i class="bi bi-check-circle me-2"></i>@message</div> }

<div class="row g-3 mb-4">
    <div class="col-6 col-xl"><div class="metric-card"><div class="metric-icon"><i class="bi bi-bar-chart-line"></i></div><span>Course Progress</span><strong>@Model.Overview.AverageCourseProgress.ToString("0.#")<span class="metric-suffix">%</span></strong><small>@Model.Overview.ActiveCourses active courses</small></div></div>
    <div class="col-6 col-xl"><div class="metric-card"><div class="metric-icon metric-icon-teal"><i class="bi bi-check2-circle"></i></div><span>Completion Rate</span><strong>@Model.Overview.AssessmentCompletionRate.ToString("0.#")<span class="metric-suffix">%</span></strong><small>@Model.Overview.CompletedAssessments completed</small></div></div>
    <div class="col-6 col-xl"><div class="metric-card"><div class="metric-icon metric-icon-warning"><i class="bi bi-award"></i></div><span>Average Score</span><strong>@(Model.Overview.AverageAssessmentScore?.ToString("0.#") ?? "—")<span class="metric-suffix">@(Model.Overview.AverageAssessmentScore.HasValue ? "%" : "")</span></strong><small>Marked assessments</small></div></div>
    <div class="col-6 col-xl"><div class="metric-card"><div class="metric-icon"><i class="bi bi-mortarboard"></i></div><span>Current CGPA</span><strong>@(Model.Overview.CurrentCgpa?.ToString("0.00") ?? "—")</strong><small>@Model.Overview.CompletedCredits.ToString("0.#") completed credits</small></div></div>
    <div class="col-6 col-xl"><div class="metric-card"><div class="metric-icon metric-icon-danger"><i class="bi bi-exclamation-triangle"></i></div><span>Overdue</span><strong>@Model.Overview.OverdueAssessments</strong><small>@Model.Overview.AttentionCourses courses need attention</small></div></div>
</div>

<section class="insights-strip mb-4">
    <div class="insights-strip-head"><div><span>Deterministic analysis</span><h2>Academic Insights</h2></div><i class="bi bi-lightbulb"></i></div>
    <div class="insight-grid">
    @foreach (var insight in Model.Insights)
    {
        <article class="insight-card @insight.Tone"><i class="bi @(insight.Tone == "success" ? "bi-graph-up-arrow" : insight.Tone == "danger" ? "bi-exclamation-octagon" : insight.Tone == "warning" ? "bi-activity" : "bi-info-circle")"></i><div><strong>@insight.Title</strong><p>@insight.Message</p></div></article>
    }
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-xl-8"><section class="card-ui h-100"><div class="card-head"><div><h2>Progress trend</h2><p>Course progress and assessment completion from saved snapshots</p></div>@if (Model.SnapshotProgressChange.HasValue) { <span class="trend-change @(Model.SnapshotProgressChange.Value >= 0 ? "positive" : "negative")">@Model.SnapshotProgressChange.Value.ToString("+0.#;-0.#;0") pts</span> }</div><div class="card-body-ui chart-panel">@if (Model.Snapshots.Count < 2) { <div class="chart-empty"><i class="bi bi-camera"></i><strong>More snapshots needed</strong><p>Save snapshots on different days to create a historical progress trend.</p></div> } else { <canvas id="snapshotTrendChart"></canvas> }</div></section></div>
    <div class="col-xl-4"><section class="card-ui h-100"><div class="card-head"><div><h2>Assessment status</h2><p>Current active-course workload</p></div></div><div class="card-body-ui chart-panel chart-panel-small">@if (Model.Overview.TotalAssessments == 0) { <div class="chart-empty"><i class="bi bi-clipboard2"></i><strong>No assessments</strong><p>Add assessments to see distribution.</p></div> } else { <canvas id="assessmentStatusChart"></canvas> }</div></section></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-6"><section class="card-ui h-100"><div class="card-head"><div><h2>Course performance</h2><p>Progress compared with marked assessment scores</p></div></div><div class="card-body-ui chart-panel">@if (Model.Courses.Count == 0) { <div class="chart-empty"><i class="bi bi-journals"></i><strong>No active courses</strong></div> } else { <canvas id="coursePerformanceChart"></canvas> }</div></section></div>
    <div class="col-xl-6"><section class="card-ui h-100"><div class="card-head"><div><h2>GPA trend</h2><p>Actual published grades by saved semester</p></div></div><div class="card-body-ui chart-panel">@if (Model.GpaTrend.Count == 0) { <div class="chart-empty"><i class="bi bi-mortarboard"></i><strong>No actual semester results</strong><p>Add actual grades in GPA Planner.</p></div> } else { <canvas id="gpaTrendChart"></canvas> }</div></section></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8"><section class="card-ui overflow-hidden"><div class="card-head"><div><h2>Course health</h2><p>Real progress, marks, workload and priority evidence</p></div></div>@if (Model.Courses.Count == 0) { <div class="empty-module-state"><div class="empty-icon"><i class="bi bi-journals"></i></div><h2>No active course data</h2></div> } else { <div class="table-responsive"><table class="table progress-course-table align-middle mb-0"><thead><tr><th>Course</th><th>Progress</th><th>Assessment Avg.</th><th>Completion</th><th>Actual Grade</th><th>Status</th></tr></thead><tbody>@foreach (var course in Model.Courses.OrderByDescending(x => x.NeedsAttention).ThenBy(x => x.CourseCode)) { <tr><td><a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId" class="assessment-title">@course.CourseCode</a><small>@course.CourseName</small></td><td><strong>@course.ProgressPercentage%</strong><div class="progress mini-progress"><div class="progress-bar" style="width:@course.ProgressPercentage%"></div></div></td><td><strong>@(course.AssessmentAverage?.ToString("0.#") ?? "—")</strong></td><td><strong>@course.AssessmentCompletionRate.ToString("0.#")%</strong><small>@course.PendingAssessments pending · @course.OverdueAssessments overdue</small></td><td><strong>@(course.ActualGrade ?? "Pending")</strong>@if (course.GradePoint.HasValue) { <small>@course.GradePoint.Value.ToString("0.00") points</small> }</td><td>@if (course.NeedsAttention) { <span class="health-badge risk">Needs attention</span> } else { <span class="health-badge healthy">On track</span> }</td></tr> }</tbody></table></div> }</section></div>
    <div class="col-xl-4"><section class="card-ui h-100"><div class="card-head"><div><h2>Performance by type</h2><p>Average score and completion</p></div></div><div class="card-body-ui chart-panel">@if (Model.AssessmentTypes.Count == 0) { <div class="chart-empty"><i class="bi bi-bar-chart"></i><strong>No assessment types</strong></div> } else { <canvas id="assessmentTypeChart"></canvas> }</div></section></div>
</div>

<div class="row g-4">
    <div class="col-xl-8"><section class="card-ui overflow-hidden"><div class="card-head"><div><h2>Snapshot history</h2><p>One updatable snapshot per day</p></div><span class="mini-badge neutral">@Model.Snapshots.Count records</span></div>@if (Model.Snapshots.Count == 0) { <div class="module-empty-inline m-3"><i class="bi bi-camera"></i><div><strong>No snapshots in this period</strong><p>Use Save Today's Snapshot to start tracking change over time.</p></div></div> } else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Progress</th><th>Completion</th><th>Avg. Score</th><th>CGPA</th><th></th></tr></thead><tbody>@foreach (var snapshot in Model.Snapshots.OrderByDescending(x => x.SnapshotDate)) { <tr><td><strong>@snapshot.SnapshotDate.ToString("dd MMM yyyy")</strong></td><td>@snapshot.AverageCourseProgress.ToString("0.#")%</td><td>@snapshot.AssessmentCompletionRate.ToString("0.#")%</td><td>@(snapshot.AverageAssessmentScore?.ToString("0.#") ?? "—")</td><td>@(snapshot.CurrentCgpa?.ToString("0.00") ?? "—")</td><td class="text-end"><form asp-action="DeleteSnapshot" asp-route-id="@snapshot.Id" asp-route-period="@Model.PeriodDays" method="post" onsubmit="return confirm('Delete this progress snapshot?');"><button class="btn btn-sm btn-ghost text-danger" type="submit" aria-label="Delete snapshot"><i class="bi bi-trash3"></i></button></form></td></tr> }</tbody></table></div> }</section></div>
    <div class="col-xl-4"><section class="card-ui unavailable-module"><div class="card-body-ui"><div class="unavailable-icon"><i class="bi bi-stopwatch"></i></div><h2>Study-hour analytics</h2><p>Study time and productivity charts will activate after the Study Planner module records real sessions. No mock data is shown.</p><span class="mini-badge neutral">Waiting for Study Planner</span></div></section></div>
</div>

<script id="progressChartData" type="application/json">@Html.Raw(chartJson)</script>
@section Scripts { <script src="~/js/progress-insights.js" asp-append-version="true"></script> }
