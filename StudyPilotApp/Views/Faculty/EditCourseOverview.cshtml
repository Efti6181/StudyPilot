@model FacultyCourseOverviewViewModel
@{ ViewData["Title"] = "Edit Course Overview"; Layout = "/Views/Shared/_FacultyLayout.cshtml"; }
<section class="faculty-heading"><div><a class="faculty-back" asp-action="Course" asp-route-id="@Model.AssignmentId"><i class="bi bi-arrow-left"></i>@Model.Code</a><h1>Edit teaching overview</h1><p>Add section-specific guidance without changing the official catalog record.</p></div></section>
<form class="faculty-panel faculty-overview-form" asp-action="EditCourseOverview" asp-route-id="@Model.AssignmentId" method="post" novalidate><input asp-for="AssignmentId" type="hidden" /><header><span>@Model.Code</span><div><h2>@Model.Name</h2><p>The official course code, title, credits and department remain controlled by Admin.</p></div></header><label><span>Teaching overview</span><textarea asp-for="CourseOverview" rows="10" maxlength="1500" placeholder="Describe section focus, learning goals, weekly expectations, or teaching approach."></textarea><small asp-validation-for="CourseOverview"></small></label><footer><a class="faculty-secondary" asp-action="Course" asp-route-id="@Model.AssignmentId">Cancel</a><button class="faculty-primary" type="submit"><i class="bi bi-check2-circle"></i>Save overview</button></footer></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
