@model FacultyCoursesViewModel
@{ ViewData["Title"] = "My Courses"; Layout = "/Views/Shared/_FacultyLayout.cshtml"; }
<section class="faculty-heading"><div><span>ACADEMICS</span><h1>My Courses</h1><p>Courses assigned to you by an administrator for each academic term.</p></div></section>
<section class="faculty-course-stats"><div><small>All assignments</small><strong>@Model.TotalCount</strong></div><div><small>Active assignments</small><strong>@Model.ActiveCount</strong></div><div><small>Academic terms</small><strong>@Model.Periods.Count</strong></div></section>
<section class="faculty-panel"><form method="get" class="faculty-filters"><label><i class="bi bi-search"></i><input name="search" value="@Model.Search" maxlength="100" placeholder="Search code, title or section" /></label><select asp-for="AcademicPeriodId"><option value="">All academic terms</option>@foreach(var period in Model.Periods){<option value="@period.Id">@period.Label@(period.IsCurrent ? " (Current)" : "")</option>}</select><label class="faculty-inline-check"><input asp-for="ActiveOnly" />Active only</label><button class="faculty-secondary" type="submit"><i class="bi bi-funnel"></i>Filter</button></form>
@if(Model.Courses.Count==0){<div class="faculty-empty"><i class="bi bi-journal-x"></i><h3>No assigned courses found</h3><p>An administrator can assign faculty from Admin → Course Catalog → Course Details.</p></div>}else{<div class="faculty-course-grid">@foreach(var course in Model.Courses){<a asp-action="Course" asp-route-id="@course.AssignmentId"><header><span>@course.Code</span><em class="@(course.IsActive ? "active" : "inactive")">@(course.IsActive ? "Active" : "Inactive")</em></header><h2>@course.Name</h2><p>@course.DepartmentCode · @(course.ProgramName ?? "All programs")</p><div><span><i class="bi bi-calendar3"></i>@course.Term @course.AcademicYear</span><span><i class="bi bi-people"></i>Section @course.Section</span><span><i class="bi bi-award"></i>@course.CreditHours.ToString("0.#") credits</span></div><footer><span>@course.CourseType</span><strong>Open course <i class="bi bi-arrow-right"></i></strong></footer></a>}</div>}</section>
