@model FacultyCourseDetailsViewModel
@{ ViewData["Title"] = Model.Course.Code; Layout = "/Views/Shared/_FacultyLayout.cshtml"; var c=Model.Course; }
<section class="faculty-heading"><div><a class="faculty-back" asp-action="Courses"><i class="bi bi-arrow-left"></i>My Courses</a><h1>@c.Code — @c.Name</h1><p>@c.Term @c.AcademicYear · Section @c.Section</p></div><a class="faculty-secondary" asp-action="EditCourseOverview" asp-route-id="@c.AssignmentId"><i class="bi bi-pencil"></i>Edit teaching overview</a></section>
<div class="faculty-course-detail-grid"><section class="faculty-panel faculty-course-hero"><span>@c.Code</span><div><div class="faculty-tags"><em>@c.CourseType</em><em>@c.Difficulty</em><em>@c.CareerRelevance career relevance</em></div><h2>@c.Name</h2><p>@(string.IsNullOrWhiteSpace(c.CourseOverview) ? c.CatalogDescription ?? "No course overview has been added." : c.CourseOverview)</p><dl><div><dt>Department</dt><dd>@c.DepartmentCode — @c.DepartmentName</dd></div><div><dt>Program</dt><dd>@(c.ProgramName ?? "All department programs")</dd></div><div><dt>Credits</dt><dd>@c.CreditHours.ToString("0.#")</dd></div><div><dt>Assigned</dt><dd>@c.AssignedAt.ToLocalTime().ToString("dd MMM yyyy")</dd></div></dl></div></section><aside class="faculty-panel faculty-course-meta"><h2>Course structure</h2><dl><div><dt>Academic term</dt><dd>@c.Term @c.AcademicYear</dd></div><div><dt>Section</dt><dd>@c.Section</dd></div><div><dt>Status</dt><dd>@(c.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Prerequisites</dt><dd>@(c.Prerequisites ?? "None specified")</dd></div></dl></aside></div>
<section class="faculty-coming-tools"><a asp-controller="FacultyAssessments" asp-action="Index" asp-route-assignmentId="@c.AssignmentId"><i class="bi bi-clipboard2-check"></i><h3>Assessments</h3><p>Create and publish assessments for this course.</p></a><a asp-controller="FacultyResources" asp-action="Index" asp-route-assignmentId="@c.AssignmentId"><i class="bi bi-collection"></i><h3>Resources</h3><p>Publish learning materials to matching students.</p></a><a asp-controller="FacultyAnnouncements" asp-action="Index" asp-route-assignmentId="@c.AssignmentId"><i class="bi bi-megaphone"></i><h3>Announcements</h3><p>Send targeted updates to this course.</p></a></section>
