@model StudyPilotApp.ViewModels.AssessmentFormViewModel
@{
    ViewData["Title"] = "Edit Assessment";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
}

<div class="page-heading">
    <div><h1>Edit Assessment</h1><p>Update the deadline, progress, marks, or notes.</p></div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost"><i class="bi bi-arrow-left me-2"></i>Back</a>
</div>

<section class="card-ui assessment-form-card">
    <div class="card-head"><div><h2>Assessment details</h2><p>Your changes are saved to PostgreSQL.</p></div></div>
    <div class="card-body-ui">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <partial name="_AssessmentForm" model="Model" />
            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-2"></i>Save Changes</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/assessments.js" asp-append-version="true"></script>
}
