@model StudyPilotApp.ViewModels.AssessmentFormViewModel
@{
    ViewData["Title"] = "Add Assessment";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
}

<div class="page-heading">
    <div><h1>Add Assessment</h1><p>Connect a deadline to one of your courses.</p></div>
    <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-2"></i>Back</a>
</div>

<section class="card-ui assessment-form-card">
    <div class="card-head"><div><h2>Assessment details</h2><p>Fields marked as required are validated on the server.</p></div></div>
    <div class="card-body-ui">
        <form asp-action="Create" method="post">
            <partial name="_AssessmentForm" model="Model" />
            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary" disabled="@(Model.CourseOptions.Count == 0 ? "disabled" : null)"><i class="bi bi-check2-circle me-2"></i>Save Assessment</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/assessments.js" asp-append-version="true"></script>
}
