@model FacultyAnnouncementFormViewModel
@{ ViewData["Title"] = "Edit Announcement"; Layout = "/Views/Shared/_FacultyLayout.cshtml"; }
<section class="faculty-heading"><div><a class="faculty-back" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i>Announcement details</a><h1>Edit announcement</h1><p>@(Model.CurrentStatus == FacultyAnnouncementStatus.Published ? "Students will see the updated content immediately." : "Review the draft before publishing it.")</p></div></section>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="faculty-panel faculty-assessment-form">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><header><div><h2>Announcement details</h2><p>Status: @Model.CurrentStatus</p></div></header><partial name="_Form" model="Model" /><footer><a class="faculty-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="faculty-primary" type="submit"><i class="bi bi-check2"></i>Save changes</button></footer></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
