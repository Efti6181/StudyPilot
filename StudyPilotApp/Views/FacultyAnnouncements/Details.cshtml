@model FacultyAnnouncementDetailsViewModel
@{ ViewData["Title"] = Model.Announcement.Title; Layout = "/Views/Shared/_FacultyLayout.cshtml"; var item = Model.Announcement; var course = item.FacultyCourseAssignment; var rate = Model.RecipientCount == 0 ? 0 : (int)Math.Round(Model.ReadCount * 100d / Model.RecipientCount); }
<section class="faculty-heading"><div><a class="faculty-back" asp-action="Index"><i class="bi bi-arrow-left"></i>Announcements</a><h1>@item.Title</h1><p>@course.CatalogCourse.Code · @course.AcademicPeriod.Term @course.AcademicPeriod.AcademicYear · Section @course.Section</p></div><div class="faculty-heading-actions">@if(item.Status != FacultyAnnouncementStatus.Archived){<a class="faculty-secondary" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i>Edit</a>}@if(item.Status == FacultyAnnouncementStatus.Draft){<form asp-action="Publish" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()<button class="faculty-primary" type="submit"><i class="bi bi-send"></i>Publish</button></form>}@if(item.Status == FacultyAnnouncementStatus.Published){<form asp-action="Archive" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()<button class="faculty-secondary" type="submit"><i class="bi bi-archive"></i>Archive</button></form>}</div></section>
<div class="faculty-resource-detail-grid">
    <section class="faculty-panel faculty-assessment-detail"><div class="faculty-resource-title"><span class="faculty-announcement-icon priority-@item.Priority.ToString().ToLowerInvariant()"><i class="bi bi-megaphone"></i></span><div><span class="faculty-status @item.Status.ToString().ToLowerInvariant()">@item.Status</span><em>@item.Priority priority</em></div></div><h2>Summary</h2><p>@item.Summary</p><h2>Full announcement</h2><p>@item.Content</p></section>
    <aside class="faculty-panel faculty-resource-meta"><h2>Delivery</h2><strong>@Model.RecipientCount</strong><p>matching student course(s)</p><div class="faculty-read-progress"><span><b>@Model.ReadCount read</b><em>@rate%</em></span><div><i style="width:@rate%"></i></div></div><dl><div><dt>Published</dt><dd>@(item.PublishedAt?.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy, h:mm tt") ?? "Not published")</dd></div><div><dt>Expires</dt><dd>@(item.ExpiresAt?.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy, h:mm tt") ?? "No expiry")</dd></div></dl>@if(item.Status == FacultyAnnouncementStatus.Draft){<form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this announcement draft?');">@Html.AntiForgeryToken()<button class="faculty-danger" type="submit"><i class="bi bi-trash"></i>Delete draft</button></form>}</aside>
</div>
