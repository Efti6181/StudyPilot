@model StudyPilotApp.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
    var currentCgpa = Model.Overview.CurrentCgpa;
}

@if (TempData["DashboardSuccess"] is string successMessage)
{
    <div class="alert alert-success dashboard-alert" role="status">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMessage</span>
    </div>
}
@if (TempData["DashboardError"] is string errorMessage)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><span>@errorMessage</span></div>
}

<div class="page-heading">
    <div>
        <h1>Student Dashboard</h1>
        <p>@Model.Greeting, @Model.FullName. Here is your live academic overview.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost" asp-controller="StudyPlan" asp-action="Index">
            <i class="bi bi-calendar2-week me-2"></i>Study routine
        </a>
        <form asp-controller="Student" asp-action="SyncProgress" method="post">
            <button class="btn btn-primary" id="syncProgress" type="submit">
                <i class="bi bi-arrow-repeat me-2"></i>Save snapshot
            </button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <a class="metric-card primary metric-link" asp-controller="Gpa" asp-action="Index">
            <div class="metric-icon"><i class="bi bi-mortarboard"></i></div>
            <div class="metric-label">Current CGPA</div>
            <div class="metric-value">@(currentCgpa?.ToString("0.00") ?? "—") <small class="metric-suffix">/ 4.00</small></div>
            <div class="metric-caption">
                @(currentCgpa.HasValue ? $"Based on {Model.Overview.CompletedCredits:0.#} graded credits" : "Add actual grades to calculate")
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="metric-card metric-link" asp-controller="Courses" asp-action="Index">
            <div class="metric-icon"><i class="bi bi-journals"></i></div>
            <div class="metric-label">Active courses</div>
            <div class="metric-value">@Model.Overview.ActiveCourses</div>
            <div class="metric-caption"><i class="bi bi-activity"></i> @Model.Overview.AttentionCourses need attention</div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="metric-card metric-link" asp-controller="Assessments" asp-action="Index">
            <div class="metric-icon metric-icon-warning"><i class="bi bi-clipboard2-check"></i></div>
            <div class="metric-label">Pending assessments</div>
            <div class="metric-value">@Model.Overview.PendingAssessments</div>
            <div class="metric-caption @(Model.Overview.OverdueAssessments > 0 ? "warn" : "up")">
                <i class="bi @(Model.Overview.OverdueAssessments > 0 ? "bi-exclamation-triangle" : "bi-check2-circle")"></i>
                @Model.Overview.OverdueAssessments overdue
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="metric-card metric-link" asp-controller="Progress" asp-action="Index">
            <div class="metric-icon metric-icon-teal"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="metric-label">Average course progress</div>
            <div class="metric-value">@Model.Overview.AverageCourseProgress.ToString("0.#")%</div>
            <div class="progress mt-3"><div class="progress-bar teal" style="width:@Math.Clamp(Model.Overview.AverageCourseProgress, 0m, 100m)%"></div></div>
        </a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-7">
        <section class="card-ui h-100">
            <div class="card-head">
                <div><h2>Academic performance</h2><p>Calculated from your saved actual grades</p></div>
                <a class="btn btn-sm btn-ghost" asp-controller="Progress" asp-action="Index">Full insights</a>
            </div>
            <div class="card-body-ui">
                @if (Model.GpaTrend.Count == 0)
                {
                    <div class="chart-empty">
                        <i class="bi bi-bar-chart-line"></i>
                        <strong>No GPA history yet</strong>
                        <p>Add actual course grades in GPA &amp; Planner to build this chart.</p>
                    </div>
                }
                else
                {
                    <div class="chart-wrap"><canvas id="gpaTrendChart" aria-label="GPA trend chart"></canvas></div>
                }
            </div>
        </section>
    </div>
    <div class="col-xl-5">
        <section class="card-ui h-100">
            <div class="card-head">
                <div><h2>Course progress</h2><p>Completion recorded across active courses</p></div>
                <a class="btn btn-sm btn-ghost" asp-controller="Courses" asp-action="Index">Manage</a>
            </div>
            <div class="card-body-ui">
                @if (Model.FocusCourses.Count == 0)
                {
                    <div class="chart-empty">
                        <i class="bi bi-journals"></i>
                        <strong>No active courses</strong>
                        <p>Add a course to start tracking academic progress.</p>
                    </div>
                }
                else
                {
                    <div class="chart-wrap"><canvas id="courseProgressChart" aria-label="Course progress chart"></canvas></div>
                }
            </div>
        </section>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-7">
        <section class="card-ui h-100">
            <div class="card-head">
                <div><h2>Upcoming assessments</h2><p>Your nearest unfinished academic deadlines</p></div>
                <a class="btn btn-sm btn-ghost" asp-controller="Assessments" asp-action="Index">View all</a>
            </div>
            <div class="card-body-ui">
                @if (Model.UpcomingAssessments.Count == 0)
                {
                    <div class="dashboard-empty"><i class="bi bi-check2-circle"></i><span>No pending assessments.</span></div>
                }
                else
                {
                    @foreach (var item in Model.UpcomingAssessments)
                    {
                        <a asp-controller="Assessments" asp-action="Details" asp-route-id="@item.Id" class="list-row">
                            <span class="list-icon @(item.IsOverdue ? "danger" : "warning")"><i class="bi bi-clipboard2-check"></i></span>
                            <div>
                                <div class="list-title">@item.Title</div>
                                <div class="list-meta">@item.CourseCode · @item.Type</div>
                            </div>
                            <div class="list-end">
                                <span class="mini-badge @(item.IsOverdue ? "danger" : item.Status == "In progress" ? "warning" : "primary")">
                                    @(item.IsOverdue ? "Overdue" : item.Status)
                                </span>
                                <div class="list-meta mt-1 @(item.IsOverdue ? "deadline-soon" : null)">@item.DueDate.ToString("dd MMM · hh:mm tt")</div>
                            </div>
                        </a>
                    }
                }
            </div>
        </section>
    </div>

    <div class="col-xl-5">
        <section class="card-ui h-100">
            <div class="card-head">
                <div><h2>Focus courses</h2><p>Courses ordered by current attention signals</p></div>
                <a class="btn btn-sm btn-ghost" asp-controller="Priorities" asp-action="Index">Priority analysis</a>
            </div>
            <div class="card-body-ui">
                @if (Model.FocusCourses.Count == 0)
                {
                    <div class="dashboard-empty"><i class="bi bi-lightning-charge"></i><span>Add active courses to generate a focus list.</span></div>
                }
                else
                {
                    @foreach (var item in Model.FocusCourses)
                    {
                        <a asp-controller="Priorities" asp-action="Details" asp-route-id="@item.CourseId" class="list-row">
                            <span class="list-icon @(item.NeedsAttention ? "danger" : "teal")"><i class="bi bi-journal-bookmark"></i></span>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between gap-2"><span class="list-title">@item.CourseCode</span><span class="list-meta">@item.ProgressPercentage%</span></div>
                                <div class="progress mt-2"><div class="progress-bar @(item.NeedsAttention ? "danger" : "teal")" style="width:@item.ProgressPercentage%"></div></div>
                                <div class="list-meta mt-1">@item.PendingAssessments pending · @item.OverdueAssessments overdue</div>
                            </div>
                            <span class="mini-badge @(item.NeedsAttention ? "danger" : "success")">@(item.NeedsAttention ? "Focus" : "On track")</span>
                        </a>
                    }
                }
            </div>
        </section>
    </div>
</div>

<section class="card-ui mb-3">
    <div class="card-head">
        <div><h2>Upcoming university events</h2><p>Published opportunities from the campus calendar</p></div>
        <a asp-controller="Events" asp-action="Index" class="btn btn-sm btn-ghost">View all</a>
    </div>
    <div class="card-body-ui">
        @if (Model.UpcomingEvents.Count == 0)
        {
            <div class="dashboard-empty"><i class="bi bi-calendar2"></i><span>No upcoming events are currently published.</span></div>
        }
        else
        {
            @foreach (var item in Model.UpcomingEvents)
            {
                var localStart = item.StartAt.ToLocalTime();
                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="list-row">
                    <span class="list-icon"><i class="bi bi-calendar-event"></i></span>
                    <div>
                        <div class="list-title">@item.Title</div>
                        <div class="list-meta">@item.Type · @item.Location</div>
                    </div>
                    <div class="list-end">
                        <span class="mini-badge @(item.IsRegistered ? "success" : "primary")">@(item.IsRegistered ? "Registered" : "Upcoming")</span>
                        <div class="list-meta mt-1">@localStart.ToString("dd MMM · hh:mm tt")</div>
                    </div>
                </a>
            }
        }
    </div>
</section>

<section class="card-ui">
    <div class="card-head"><div><h2>Quick actions</h2><p>Continue with your connected StudyPilot workflows</p></div></div>
    <div class="card-body-ui">
        <div class="row g-3">
            <div class="col-sm-6 col-xl-3">
                <a class="quick-action" asp-controller="Gpa" asp-action="Calculator"><i class="bi bi-calculator"></i><div><strong>Calculate GPA</strong><small>Test a semester outcome</small></div><i class="bi bi-chevron-right ms-auto"></i></a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a class="quick-action" asp-controller="Assessments" asp-action="Create"><i class="bi bi-calendar2-plus"></i><div><strong>Add assessment</strong><small>Record a new deadline</small></div><i class="bi bi-chevron-right ms-auto"></i></a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a class="quick-action" asp-controller="AcademicAI" asp-action="Index"><i class="bi bi-stars"></i><div><strong>Ask StudyPilot AI</strong><small>Use your academic context</small></div><i class="bi bi-chevron-right ms-auto"></i></a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a class="quick-action" asp-controller="StudyPlan" asp-action="Index"><i class="bi bi-calendar2-week"></i><div><strong>Smart study plan</strong><small>Build an AI-assisted routine</small></div><i class="bi bi-chevron-right ms-auto"></i></a>
            </div>
        </div>
    </div>
</section>

<script id="dashboardChartData" type="application/json">
    @Json.Serialize(new
    {
        gpaLabels = Model.GpaTrend.Select(item => item.Label),
        gpaValues = Model.GpaTrend.Select(item => item.Gpa),
        courseLabels = Model.FocusCourses.Select(item => item.CourseCode),
        courseValues = Model.FocusCourses.Select(item => item.ProgressPercentage)
    })
</script>
