@model StudyPilotApp.ViewModels.ResourceFormViewModel
@{
    ViewData["Title"] = "Edit Resource";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
}
@section Styles { <link rel="stylesheet" href="~/css/resources.css" asp-append-version="true" /> }

<div class="page-heading">
    <div><h1>Edit Resource</h1><p>Update the resource information or replace its uploaded file.</p></div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost"><i class="bi bi-arrow-left me-2"></i>Back to Details</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card-ui resource-form-card">
    <input asp-for="Id" type="hidden" />
    <div class="card-body-ui">
        <partial name="_ResourceForm" model="Model" />
    </div>
    <div class="resource-form-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-2"></i>Save Changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/resources.js" asp-append-version="true"></script>
}
