@model StudyPilotApp.ViewModels.ResourceDeleteViewModel
@{
    ViewData["Title"] = "Delete Resource";
    Layout = "/Views/Shared/_StudentLayout.cshtml";
}
@section Styles { <link rel="stylesheet" href="~/css/resources.css" asp-append-version="true" /> }

<div class="resource-delete-wrap">
    <section class="card-ui resource-delete-card">
        <div class="resource-delete-icon"><i class="bi bi-trash3"></i></div>
        <h1>Delete this resource?</h1>
        <p><strong>@Model.Resource.Title</strong> will be permanently removed from your StudyPilot library.</p>
        @if (Model.Resource.Kind == StudyPilotApp.Models.ResourceKind.File)
        {
            <div class="alert alert-warning rounded-4"><i class="bi bi-exclamation-triangle me-2"></i>The uploaded file will also be permanently deleted.</div>
        }
        <form asp-action="Delete" asp-route-id="@Model.Resource.Id" method="post" class="d-flex justify-content-center gap-2">
            <a asp-action="Details" asp-route-id="@Model.Resource.Id" class="btn btn-ghost">Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-2"></i>Delete Permanently</button>
        </form>
    </section>
</div>
