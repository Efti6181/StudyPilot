@model StudyPilotApp.ViewModels.StudentShellViewModel
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var profileImageUrl = Model.HasProfileImage
        ? Url.Action("ProfileImage", "Student", new { v = Model.ProfileImageVersion })
        : null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="StudyPilot student academic dashboard." />
    <title>@ViewData["Title"] - StudyPilot</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/studypilot.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-page="dashboard">
    <div class="page-loader" id="pageLoader" aria-live="polite" aria-label="Loading dashboard">
        <div class="loader-mark">
            <div class="loader-ring"></div>
            <i class="bi bi-mortarboard-fill loader-cap"></i>
        </div>
    </div>

    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a asp-controller="Student" asp-action="Index" class="brand" aria-label="StudyPilot student dashboard">
                <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                <span class="brand-copy">StudyPilot<small>Academic success</small></span>
            </a>

            <nav class="sidebar-nav" aria-label="Student navigation">
                <div class="sidebar-label">Overview</div>
                <a class="sidebar-link @(currentController == "Student" && currentAction == "Index" ? "active" : null)" asp-controller="Student" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Student Dashboard</span>
                </a>
                <a class="sidebar-link @(currentController == "Student" && currentAction == "Profile" ? "active" : null)" asp-controller="Student" asp-action="Profile">
                    <i class="bi bi-person"></i><span>My Profile</span>
                </a>

                <div class="sidebar-label">Academics</div>
                <a class="sidebar-link @(currentController == "Courses" ? "active" : null)" asp-controller="Courses" asp-action="Index">
                    <i class="bi bi-journals"></i><span>Courses</span>
                </a>
                <a class="sidebar-link @(currentController == "Assessments" ? "active" : null)" asp-controller="Assessments" asp-action="Index">
                    <i class="bi bi-clipboard2-check"></i><span>Assessments</span>
                </a>
                <a class="sidebar-link @(currentController == "Gpa" ? "active" : null)" asp-controller="Gpa" asp-action="Index">
                    <i class="bi bi-calculator"></i><span>GPA &amp; Planner</span>
                </a>
                <a class="sidebar-link @(currentController == "Priorities" ? "active" : null)" asp-controller="Priorities" asp-action="Index">
                    <i class="bi bi-lightning-charge"></i><span>Priorities</span>
                </a>

                <div class="sidebar-label">Growth</div>
                <a class="sidebar-link @(currentController == "Progress" ? "active" : null)" asp-controller="Progress" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i><span>Progress &amp; Insights</span>
                </a>
                <a class="sidebar-link @(currentController == "Resources" ? "active" : null)" asp-controller="Resources" asp-action="Index">
                    <i class="bi bi-collection-play"></i><span>Resources</span>
                </a>
                <a class="sidebar-link @(currentController == "Community" ? "active" : null)" asp-controller="Community" asp-action="Index">
                    <i class="bi bi-people"></i><span>Community</span>
                </a>

                <div class="sidebar-label">Campus</div>
                <a class="sidebar-link @(currentController == "Events" ? "active" : null)" asp-controller="Events" asp-action="Index">
                    <i class="bi bi-calendar-event"></i><span>Events</span>
                </a>
                <a class="sidebar-link @(currentController == "Notifications" ? "active" : null)" asp-controller="Notifications" asp-action="Index">
                    <i class="bi bi-bell"></i><span>Notifications</span><span class="nav-pill">New</span>
                </a>
            </nav>

            <div class="sidebar-user">
                <span class="avatar">
                    @if (Model.HasProfileImage)
                    {
                        <img src="@profileImageUrl" alt="@Model.FullName" />
                    }
                    else
                    {
                        @Model.Initials
                    }
                </span>
                <div class="sidebar-user-copy">
                    <strong>@Model.FullName</strong>
                    <small>@Model.DepartmentLabel · @Model.SemesterLabel</small>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                    <button class="sidebar-logout" type="submit" title="Logout" aria-label="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-icon btn-ghost mobile-menu" id="mobileMenu" type="button" aria-label="Open navigation">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control" id="globalSearch" type="search" placeholder="Search courses, resources, events…" aria-label="Search" />
                </div>

                <div class="topbar-actions">
                    <button class="btn btn-icon theme-toggle" type="button" aria-label="Switch color theme">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    @await Component.InvokeAsync("NotificationBell")
                    <a class="topbar-profile" asp-controller="Student" asp-action="Profile">
                        <span class="avatar">
                            @if (Model.HasProfileImage)
                            {
                                <img src="@profileImageUrl" alt="@Model.FullName" />
                            }
                            else
                            {
                                @Model.Initials
                            }
                        </span>
                        <div><strong>@Model.FullName</strong><small>Student</small></div>
                    </a>
                </div>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="toast-stack" id="toastStack" aria-live="polite"></div>

    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="appModalTitle">StudyPilot</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="appModalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
